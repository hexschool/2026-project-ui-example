{
  "name": "craftory-05-swiss-style",
  "private": true,
  "version": "1.0.0",
  "description": "Craftory 手感工藝線上學院｜設計稿 05 瑞士國際排版（Bootstrap 5 + HTML + CSS + JS，無打包工具）",
  "scripts": {
    "vendor": "node scripts/copy-vendor.mjs",
    "css": "sass --load-path=node_modules --no-source-map --quiet-deps --silence-deprecation=import --silence-deprecation=global-builtin --silence-deprecation=color-functions --silence-deprecation=if-function scss/main.scss css/style.css",
    "watch": "sass --no-source-map --load-path=node_modules --quiet-deps --silence-deprecation=import --silence-deprecation=global-builtin --silence-deprecation=color-functions --silence-deprecation=if-function --watch scss/main.scss css/style.css",
    "build": "npm run vendor && npm run css",
    "postinstall": "npm run vendor",
    "images": "node scripts/generate-images.mjs",
    "check": "node scripts/check-layout.mjs"
  },
  "devDependencies": {
    "bootstrap": "^5.3.8",
    "bootstrap-icons": "^1.13.1",
    "sass": "^1.105.0"
  }
}
